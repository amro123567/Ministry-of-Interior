# Used by `docker compose up` (Compose reads a file named .env in this same
# folder automatically). Copy this to .env and fill in real values before
# running Docker -- .env is gitignored and must never be committed.
#
# This is separate from backend/.env, which is only used when you run the
# backend directly with `mvn spring-boot:run` outside of Docker.

MYSQL_ROOT_PASSWORD=choose-a-root-password
MYSQL_DATABASE=cts_spring_db
MYSQL_USER=cts_spring
MYSQL_PASSWORD=choose-an-app-password

# A PowerShell one-liner to generate one:
# [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
JWT_SECRET=generate-a-long-random-string
