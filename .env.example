# Copy this file to `.env` and fill in your MySQL password.
# `.env` is listed in .gitignore and must never be committed.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=civil_registry_db
MYSQL_USER=cts_app
MYSQL_PASSWORD=change-me

# Flask session signing key. Any long random string.
SECRET_KEY=change-me-to-something-long-and-random

# A full DATABASE_URL overrides all of the above. See config.py if you need
# one (a remote server, a socket, TLS options); do not set it otherwise.
