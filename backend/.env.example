# Copy this file to .env in the same folder as pom.xml, fill in real values,
# and never commit the real .env (it is already in .gitignore).

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cts_spring_db
MYSQL_USER=cts_spring
MYSQL_PASSWORD=choose-an-app-password

# 32+ random characters. Generate one with: openssl rand -base64 48
JWT_SECRET=generate-a-long-random-string

# Where uploaded documents are stored on disk.
DOCUMENTS_DIR=./uploaded-documents

# The frontend's origin(s), comma-separated. Vite's dev server defaults to
# 5173 and may answer on either host name depending on how you start it.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
