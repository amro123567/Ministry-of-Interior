// ---- Referential actions ----
// citizens.civil_registry_number  ->  ON UPDATE CASCADE, ON DELETE RESTRICT
// documents.id -> subtype tables  ->  ON DELETE CASCADE
// any FK -> users.id              ->  ON DELETE RESTRICT
// audit/access logs -> subject    ->  ON DELETE RESTRICT
// citizens.father_id / mother_id  ->  ON DELETE SET NULL
// reference tables -> children    ->  ON DELETE RESTRICT


